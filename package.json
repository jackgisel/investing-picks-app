{
  "name": "outpick",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "cd apps/api && PYTHONPATH=. ../../.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "db:refresh-local": "sh scripts/local-prod-clone/refresh.sh",
    "test": "pnpm test:strategy && pnpm test:api && pnpm test:web",
    "test:strategy": "sh scripts/pytest.sh packages/strategy/tests -q",
    "test:api": "sh scripts/pytest.sh apps/api/tests -q",
    "test:web": "pnpm --dir apps/web check",
    "build:web": "pnpm --dir apps/web build"
  }
}
