# Copy to .env.local (git-ignored) and fill in. Nothing in this file is a
# real credential.

# ElevenLabs — narration synthesis. One request per scene, eleven_v3.
ELEVENLABS_API_KEY=
OUTPICK_ELEVENLABS_VOICE_ID=

# Anthropic — turns a pack into a script (narration + slide bindings).
ANTHROPIC_API_KEY=

# Where `pack` fetches portfolio facts from. Points at the local FastAPI dev
# server by default; point it at a deployed API to pack a real episode.
OUTPICK_API_URL=http://localhost:8000

# Staff-only ratings brief used for the video watchlist and sector breadth.
OPS_API_KEY=

# Read-only access to the web app's Postgres, for pulling the source post
# (market_note_issue / insight rows) that the pack is built from.
WEB_DATABASE_URL=postgresql://jackgisel@localhost:5432/outpick_web_dev

# Days after a position's entry_date before its ticker and name are safe to
# name in a video. Matches the strategy's biweekly evaluation cadence — see
# the "claims gate" section of DESIGN.md.
VIDEO_PICK_EMBARGO_DAYS=14

# Used to build the outro's "read the full note at ..." URL.
SITE_URL=https://outpick.io
