# Database (API + worker). Local default is SQLite if unset.
DATABASE_URL=postgresql+psycopg://outpick:outpick@localhost:5432/outpick

# FMP
FMP_API_KEY=
# Total weekly refresh budget; also controls when orphaned runs are reaped.
WEEKLY_REFRESH_TIMEOUT_MINUTES=60

# Ops
OPS_API_KEY=dev-ops-key
INITIAL_CASH=100000

# Web → API
OUTPICK_API_URL=http://localhost:8000

# Web auth / billing (apps/web)
# DATABASE_URL=...  (BetterAuth Postgres — can share or separate)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_FOUNDERS_COUPON_ID=
# Keep false until Stripe shows an active tax registration confirmed by an adviser.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Temporary live smoke-test override. Remove both immediately after validation.
STRIPE_PRODUCTION_TEST_EMAIL=
STRIPE_PRODUCTION_TEST_COUPON_ID=

# Research notes (apps/web) — drafting and auto-publish
ANTHROPIC_API_KEY=
RESEND_API_KEY=
ADMIN_EMAILS=
# Shared bearer for the worker's /api/internal/* calls, and the web app's
# address as the worker sees it (a bare Railway hostname is fine).
INTERNAL_API_SECRET=
WEB_APP_URL=http://localhost:3000
#
# A drafted note PUBLISHES ITSELF and emails every opted-in subscriber once
# this many hours pass, unless an admin rejects it at /dashboard/ops/insights.
# The window is stamped when the draft is written; editing does not extend it,
# regenerating restarts it. 0 means "send on the next 15-minute sweep".
INSIGHT_REVIEW_WINDOW_HOURS=24
# Kill switch. false/0/off stops every auto-send without a deploy; drafts then
# wait for the approve button. Anything else (including unset) means enabled.
AUTO_PUBLISH_ENABLED=true
